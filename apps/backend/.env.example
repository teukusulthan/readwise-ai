# Every key MUST carry the BE_ prefix; code reads it unprefixed (BE_MONGO_URI -> settings.MONGO_URI).
# Local defaults below match the root docker-compose.yml. Never commit a real .env.

# ── Routers ───────────────────────────────────────────────────────────
BE_ACTIVE_ROUTERS={}
# Comma-separated routers to mount. Empty = the safe default: health, auth, book, search, chat,
# conversation. The legacy boilerplate admin surface (user, role, group, permission, upload and
# the "monitoring" /monitoring/threadpool endpoint) is mounted ONLY when listed here, e.g.
# BE_ENABLED_ROUTERS=health,auth,book,search,chat,conversation,user,role. /health is always mounted.
BE_ENABLED_ROUTERS=
BE_ALLOWED_GATEWAY_NETWORKS= # If use API gateway skill, you can set the allowed networks here, e.g. BE_ALLOWED_GATEWAY_NETWORKS= "10.0.0.0/24,10.0.1.0/24"
BE_BASE_RESPONSE_CASE=

# ── HTTP hardening ────────────────────────────────────────────────────
# Comma-separated browser origins allowed by CORS ("*" disables credentialed requests).
BE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Session cookie secret (Google OAuth). Generate: openssl rand -hex 32. Must differ from JWT secret.
BE_SESSION_SECRET=
BE_MAX_REQUEST_BODY_MB=100
BE_MAX_UPLOAD_SIZE_MB=100
BE_RATE_LIMIT_ACTIVE=true
BE_RATE_LIMIT=300
BE_RATE_LIMIT_WINDOW=60
# Per-route budgets, requests per minute per user (else per client IP), on top of BE_RATE_LIMIT. 0 = off.
BE_RATE_LIMIT_UPLOAD_PER_MINUTE=20
BE_RATE_LIMIT_CHAT_PER_MINUTE=30
BE_RATE_LIMIT_SEARCH_PER_MINUTE=60
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted (empty = never trust it).
BE_TRUSTED_PROXIES=
BE_EXCLUDE_UPLOAD_EXTENSIONS=

# ── Auth (JWT) ────────────────────────────────────────────────────────
BE_JWT_ACTIVE=true
BE_JWT_ALGORITH=HS256
BE_JWT_EXPIRED=3600
# Required (>= 32 characters) while BE_JWT_ACTIVE=true — startup fails otherwise.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BE_JWT_SECRET=
BE_LIFETIME_JWT=
# Service token for system-to-system calls (MCP server, scripts/seed_gutenberg.py --internal-token).
# While BE_JWT_ACTIVE=true a request with header `X-Internal-Token: <this value>` is authorised as the
# service principal "service:internal": shared catalog/search/ask, no conversations (403). A wrong value is
# refused (403). Empty = disabled; when set, at least 32 characters (same generator as BE_JWT_SECRET).
BE_INTERNAL_TOKEN=
# /auth/register. true (default) = email verification: MX + Proofy check (BE_PROOFY_*), an OTP mailed via
# BE_SMTP_*, confirmed with POST /auth/verification. false = DEVELOPMENT ONLY: the account is created
# immediately, without any mail or deliverability check. Never set false on a public deployment.
BE_AUTH_EMAIL_VERIFICATION=true
# `Secure` flag of the HttpOnly auth cookies. true (default) = HTTPS only; browsers make an exception for
# http://localhost. false = DEVELOPMENT ONLY, for opening the web over plain HTTP from another host
# (http://<LAN IP>:3000): browsers drop Secure cookies there, so login would not stick. Never false in production.
BE_AUTH_COOKIE_SECURE=true

# ── Response encryption (AES) ─────────────────────────────────────────
BE_ENC_ACTIVE=false
# Required while BE_ENC_ACTIVE=true — startup fails otherwise. It is an AES-256 key, so it must be exactly 32 characters:
# python -c "import secrets; print(secrets.token_hex(16))"
BE_ENC_SECRET=
BE_ENC_SECRET_PERMISSION=

# ── PostgreSQL (new domain data) ──────────────────────────────────────
BE_POSTGRES_URI=postgresql://library:library@localhost:5433/library
BE_POSTGRES_POOL_MIN_SIZE=1
BE_POSTGRES_POOL_MAX_SIZE=10

# ── Qdrant (vector store) ─────────────────────────────────────────────
BE_QDRANT_URL=http://localhost:6333
BE_QDRANT_API_KEY=

# ── MongoDB (legacy boilerplate modules: auth/user/group/permission/role/upload) ──
BE_MONGO_URI=mongodb://localhost:27017
BE_MONGO_DB=library
BE_MONGO_COLLECTION_UPLOAD=upload
BE_MONGO_COLLECTION_CONNECTION=connection
BE_MONGO_COLLECTION_GROUP=group
BE_MONGO_COLLECTION_PERMISSION=permission
BE_MONGO_COLLECTION_USER=user
BE_MONGO_COLLECTION_ROLE=role

# ── Redis (sessions, rate limiting, OTP) ──────────────────────────────
BE_REDIS_HOST=localhost
BE_REDIS_PORT=6380
BE_REDIS_PASSWORD=
BE_REDIS_DB=0

# ── Object storage (S3-compatible) ────────────────────────────────────
# No local S3 server in docker compose yet. Fill these once one is chosen.
BE_S3FS_KEY=
BE_S3FS_SECRET=
BE_S3FS_END_POINT=
BE_S3FS_PATH_AGENT=s3://library

# ── Kafka (optional extraction queue) ─────────────────────────────────
BE_KAFKA_SERVER=
BE_KAFKA_TOPIC_FILE_EXTRACTION=
BE_KAFKA_MAX_REQUEST=1048576

# ── Optional integrations ─────────────────────────────────────────────
BE_PROOFY_API_KEY=
BE_PROOFY_URL=
BE_GOOGLE_CLIENT_ID=
BE_GOOGLE_CLIENT_SECRET=
BE_SMTP_EMAIL=
BE_SMTP_PASSWORD=
BE_SMTP_HOST=
BE_SMTP_PORT=
BE_SMTP_USE_TLS=
BE_SMTP_TYPE=
BE_SMTP_SENDER=

# ── Embedding service (company TEI, OpenAI-compatible /v1/embeddings) ─
# Docs: <BASE_URL without /v1>/docs — internal network, no auth. Ask the team for the host.
# Server limits: 32 inputs per request, 16384 tokens per input (longer input is truncated).
BE_ENGINE_EMBEDDING_BASE_URL=http://<embedding-host>:7941/v1
BE_ENGINE_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# Must equal the Qdrant collection vector size. Changing it means re-indexing.
BE_ENGINE_EMBEDDING_DIMENSIONS=1024
BE_ENGINE_EMBEDDING_BATCH_SIZE=32
BE_ENGINE_EMBEDDING_TIMEOUT_SECONDS=60
BE_ENGINE_EMBEDDING_MAX_RETRIES=3
# Queries only (Qwen3 instruction format). Clearly separates relevant from off-topic passages — keep it
# unless you re-tune BE_RETRIEVAL_MIN_SCORE.
BE_ENGINE_EMBEDDING_QUERY_INSTRUCTION=Given a question, retrieve passages from a book that answer the question

# ── Book library: storage & ingestion ─────────────────────────────────
# Uploaded PDFs (relative to apps/backend/). Git-ignored.
BE_BOOK_STORAGE_DIR=storage/books
BE_MAX_PDF_PAGES=1500
BE_QDRANT_COLLECTION=book_chunks
# Chunk size in tokens of the embedding model's tokenizer (Docling HybridChunker).
BE_CHUNK_MAX_TOKENS=512
BE_CHUNK_TOKENIZER=Qwen/Qwen3-Embedding-0.6B
# Docling is CPU/RAM heavy: keep 1 concurrent ingestion. OCR off is fast; scanned PDFs use the OCR fallback below.
BE_INGESTION_WORKERS=1
# Upload/reindex returns 429 while this many books are waiting in `queued` (0 = no cap).
BE_INGESTION_MAX_QUEUED=50
# Startup re-queues jobs a restart interrupted while the book was claimed fewer times than this;
# at the cap they are marked failed (0 = never resume).
BE_INGESTION_MAX_ATTEMPTS=3
# Docling parses in a child process, so a crashing or runaway PDF cannot take the API down.
# Per-parse wall-clock limit (child killed, book failed), RLIMIT_AS cap for the child in MB
# (0 = off; it counts virtual memory, which PyTorch reserves generously: a 3-page PDF failed at
# 6144 and parsed at 12288; too tight a cap can also hang the child until the timeout),
# and parses per child before it is replaced (bounds leaks; each new child reloads the models).
BE_INGESTION_PARSE_TIMEOUT_SECONDS=1800
BE_INGESTION_PARSE_MAX_MEMORY_MB=0
BE_INGESTION_PARSE_TASKS_PER_CHILD=20
BE_DOCLING_DO_OCR=false
# Scanned PDFs: if a parse with OCR off finds no text, retry that book once with OCR on.
BE_DOCLING_OCR_FALLBACK=true
BE_DOCLING_DO_TABLE_STRUCTURE=true
# Pages per Docling pass (bounds memory on big books) and CPU threads for Docling.
BE_DOCLING_PAGE_WINDOW=20
BE_DOCLING_NUM_THREADS=8
# Layout-model batch size: measured fastest on an 8-core CPU (higher values use more RAM and were slower).
BE_DOCLING_LAYOUT_BATCH_SIZE=1

# ── Retrieval ─────────────────────────────────────────────────────────
BE_RETRIEVAL_TOP_K=8
# Passages below this cosine similarity are ignored ("not enough information").
BE_RETRIEVAL_MIN_SCORE=0.45
# Fetch topK × this many candidates (same threshold), then keep topK with at most
# BE_RETRIEVAL_MAX_PER_SECTION passages per section (book + heading path), so near-duplicate
# passages of one chapter can't crowd out the chapter that answers. 0 = no per-section cap.
BE_RETRIEVAL_CANDIDATE_MULTIPLIER=4
BE_RETRIEVAL_MAX_PER_SECTION=2

# ── Answer policy ─────────────────────────────────────────────────────
# true: books first (cited) + general knowledge in a separate, labeled section; false: books only.
BE_RAG_ALLOW_GENERAL_KNOWLEDGE=true

# ── Resumable chat sessions (Redis) ───────────────────────────────────
# Events of an answer stay replayable this long; a running session without heartbeat for
# STALE seconds is reported as interrupted.
BE_CHAT_SESSION_TTL_SECONDS=3600
BE_CHAT_SESSION_STALE_SECONDS=30
# Answers generated at once across all users; more get HTTP 429 (0 = no cap).
BE_CHAT_MAX_CONCURRENT_SESSIONS=20

# ── Chat history ──────────────────────────────────────────────────────
# Earlier question/answer pairs sent to the LLM so follow-ups ("what did he do next?") make sense.
BE_CHAT_HISTORY_TURNS=3

# ── LLM (LiteLLM model string) ────────────────────────────────────────
# OpenRouter: BE_LLM_MODEL=openrouter/<vendor>/<model> (ids at https://openrouter.ai/models), BE_LLM_API_KEY=sk-or-v1-…,
#   leave BE_LLM_API_BASE empty. Tested 2026-10-09: openrouter/nvidia/nemotron-3-super-120b-a12b:free (free tier;
#   cites correctly, admits missing info, answers in the question's language). Gemma 4 :free models were
#   rate-limited upstream at the time. Paid alternatives: openrouter/openai/gpt-oss-120b · openrouter/google/gemma-4-31b-it
# Kimi Code plan (OpenAI-compatible, tested 2026-10-09): BE_LLM_MODEL=openai/kimi-for-coding,
#   BE_LLM_API_BASE=https://api.kimi.com/coding/v1, BE_LLM_API_KEY=sk-kimi-…, and leave BE_LLM_TEMPERATURE / BE_LLM_TOP_P
#   EMPTY (the model rejects any value but its own). Note: Kimi positions this plan for coding tools; for app use
#   it recommends a Kimi Open Platform key. OpenRouter free models share a 50 requests/day account cap (1000 with credits).
# Other providers: openai/gpt-4o-mini · anthropic/<model> · any OpenAI-compatible server via BE_LLM_API_BASE.
# Leave BE_LLM_MODEL empty to run in retrieval-only mode (passages, no generated answer).
BE_LLM_MODEL=
BE_LLM_API_KEY=
BE_LLM_API_BASE=
# Leave empty to use the provider's default — required for models with fixed sampling
# (e.g. Kimi Code accepts only temperature 1 / top_p 0.95 and rejects anything else).
BE_LLM_TEMPERATURE=0.1
BE_LLM_TOP_P=
# Reasoning models use part of this budget for hidden thinking: keep it generous.
BE_LLM_MAX_TOKENS=4000
# Request timeout (seconds) and retries on transient provider errors, passed to LiteLLM.
BE_LLM_TIMEOUT_SECONDS=120
BE_LLM_NUM_RETRIES=2
# Streaming: give up when no token (answer or reasoning) arrives within this many seconds.
BE_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=90

# ── Book metadata import ──────────────────────────────────────────────
BE_OPENLIBRARY_BASE_URL=https://openlibrary.org
