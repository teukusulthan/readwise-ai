# Rendered by the nginx image's envsubst step: only ${BACKEND_UPSTREAM} is substituted
# (nginx's own $variables are left alone because they are not set in the environment).

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Matches the backend upload cap (BE_MAX_UPLOAD_SIZE_MB / BE_MAX_REQUEST_BODY_MB, default 100) plus multipart overhead.
    client_max_body_size 110m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Answers are streamed over Server-Sent Events: no buffering, long read timeout.
    location /api/v1/apps/chat/stream {
        proxy_pass ${BACKEND_UPSTREAM}/chat/stream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # One-shot answer (JSON, not streamed): the backend may spend BE_LLM_TIMEOUT_SECONDS (120) on each of
    # 1 + BE_LLM_NUM_RETRIES (2) provider attempts, i.e. up to ~360 s plus retrieval, so the 300 s of the
    # generic API location below would cut it off. Keep in step with the MCP's LIBRARY_TIMEOUT_SECONDS.
    location = /api/v1/apps/chat/ask {
        proxy_pass ${BACKEND_UPSTREAM}/chat/ask;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 420s;
        proxy_send_timeout 420s;
    }

    # REST API. The trailing slash strips /api/v1/apps/ (same rewrite as the Vite dev proxy).
    location /api/v1/apps/ {
        proxy_pass ${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Icon font CDN (or a 404 when ICON_CDN_PROXY_TARGET is unset); written at startup by 15-cdn-assets.sh.
    include /tmp/cdn-assets.conf;

    # Hashed build assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # SPA fallback; index.html must always be revalidated so a new build is picked up.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri $uri/ /index.html;
    }
}
