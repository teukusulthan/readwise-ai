# Dev server (read by vite.config.ts only — not exposed to the browser)
# PORT=3000
# Backend the dev proxy forwards `/api/v1/apps/*` to (default http://0.0.0.0:8020 from proxy.config.json)
# BACKEND_PROXY_TARGET=http://localhost:8021
# Icon font CDN behind `/cdn-assets/*` (Phosphor icons). Required, or icons won't load.
# Ask the team for the host; it is not committed.
ICON_CDN_PROXY_TARGET=

# API
# Base path for backend calls. Default `/api/v1` goes through the Vite dev proxy
# (`/api/v1/apps` -> backend, prefix stripped; see proxy.config.json).
VITE_API_BASE_URL=/api/v1

# Map
VITE_MAPBOX_TOKEN=
