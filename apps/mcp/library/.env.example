# Readwise AI library MCP server — copy to .env (git-ignored) or export in the shell.

# Backend REST API this server calls (and nothing else: never the databases).
LIBRARY_API_URL=http://localhost:8020
# Sent as X-Internal-Token. Must equal the backend's BE_INTERNAL_TOKEN.
# Leave empty only when the backend runs with BE_JWT_ACTIVE=false (local dev).
LIBRARY_INTERNAL_TOKEN=
# Per-request timeout in seconds (ask_library waits for a whole LLM answer).
LIBRARY_TIMEOUT_SECONDS=120

# Inbound auth for the HTTP transport (stdio needs none). Required, >= 32 chars:
#   openssl rand -hex 32
MCP_BEARER_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8030
