{
  "name": "readwise-ai-runner",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "nx run-many -t serve --projects=backend,web --parallel=2 --outputStyle=stream",
    "setup:backend": "uv sync --directory apps/backend",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup:web": "npm install --prefix apps/web"
  },
  "devDependencies": {
    "nx": "23.0.1"
  }
}